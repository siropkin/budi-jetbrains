<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.siropkin.budijetbrains</id>
    <name>budi</name>
    <vendor email="ivan@siropkin.dev" url="https://getbudi.dev">siropkin</vendor>

    <description><![CDATA[
        <p>See what your AI coding costs at a glance. <b>budi</b> sits in your status bar and shows rolling spend for the last <b>1 day / 7 days / 30 days</b>, scoped to your JetBrains IDE. No extra panels, no popups — just three numbers in the corner.</p>

        <p><code>budi · $2.34 1d · $12.50 7d · $48.10 30d</code></p>

        <table>
            <tr><th>State</th><th>Status bar</th><th>What it means</th></tr>
            <tr><td>healthy</td><td><code>budi · $X 1d · $Y 7d · $Z 30d</code></td><td>Daemon running, spend recorded in the rolling window.</td></tr>
            <tr><td>idle</td><td><code>budi · $0.00 1d · $0.00 7d · $0.00 30d</code></td><td>Daemon running, no spend yet (not an error).</td></tr>
            <tr><td>offline</td><td><code>budi · offline</code></td><td>Daemon not reachable. Run <code>budi doctor</code> to diagnose.</td></tr>
            <tr><td>loading</td><td><code>budi</code></td><td>Starting up, first reading on the way.</td></tr>
            <tr><td>setup</td><td><code>budi · setup</code></td><td>First run — click to install the budi daemon.</td></tr>
        </table>

        <p>Click the widget to open the <a href="https://app.getbudi.dev">cloud dashboard</a>. Spend is broken down by editor so you can see exactly where your AI budget goes.</p>

        <h3>Install</h3>
        <p>Search <b>budi</b> in <b>Settings → Plugins → Marketplace</b>. Or via the CLI:<br/>
        <code>budi integrations install --with jetbrains-plugin</code></p>

        <h3>Prerequisites</h3>
        <p>budi needs a local <a href="https://getbudi.dev">daemon</a> to read your AI usage. Install it with <code>budi init</code> — it starts automatically and runs in the background.</p>

        <h3>Ecosystem</h3>
        <p>
            <a href="https://github.com/siropkin/budi">budi</a> (daemon + CLI) ·
            <a href="https://github.com/siropkin/budi-cursor">budi-cursor</a> (VS Code / Cursor extension) ·
            <a href="https://app.getbudi.dev">budi-cloud</a> (dashboard) ·
            <a href="https://getbudi.dev">getbudi.dev</a>
        </p>
    ]]></description>

    <change-notes><![CDATA[
        <h3>0.1.0</h3>
        <ul>
            <li>Initial release. Status-bar widget, daemon health polling, surface=jetbrains analytics filter.</li>
        </ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Application-scoped services. Project-scoped poller would
             multiply daemon hits by the number of open projects. -->
        <applicationService
            serviceImplementation="com.github.siropkin.budijetbrains.settings.BudiSettings"/>
        <applicationService
            serviceImplementation="com.github.siropkin.budijetbrains.state.BudiAppState"/>
        <applicationService
            serviceImplementation="com.github.siropkin.budijetbrains.poller.BudiPoller"/>
        <applicationService
            serviceImplementation="com.github.siropkin.budijetbrains.notifier.BudiUpgradeNotifier"/>

        <!-- Status bar widget. One instance per open project; reads from
             the application-scoped state above. -->
        <statusBarWidgetFactory
            id="BudiStatusBarWidget"
            implementation="com.github.siropkin.budijetbrains.statusbar.BudiStatusBarWidgetFactory"
            order="last"/>

        <!-- Settings page rendered under Settings → Tools → budi. -->
        <applicationConfigurable
            parentId="tools"
            id="com.github.siropkin.budijetbrains.settings.BudiConfigurable"
            displayName="budi"
            instance="com.github.siropkin.budijetbrains.settings.BudiConfigurable"/>

        <!-- Sticky balloon group for the welcome notification + later the
             upgrade-prompt notification (#7). isLogByDefault keeps the
             notification searchable in Event Log if it's dismissed before
             the user reads it. -->
        <notificationGroup
            id="Budi"
            displayType="STICKY_BALLOON"
            isLogByDefault="true"/>

        <!-- Boot the poller + welcome notification on first project open. -->
        <postStartupActivity
            implementation="com.github.siropkin.budijetbrains.startup.BudiProjectActivity"/>
    </extensions>
</idea-plugin>
