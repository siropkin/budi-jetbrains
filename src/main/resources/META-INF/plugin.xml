<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.siropkin.budijetbrains</id>
    <name>budi</name>
    <vendor email="ivan@siropkin.dev" url="https://getbudi.dev">siropkin</vendor>

    <description><![CDATA[
        <p><b>budi</b> is a quiet status-bar widget for JetBrains IDEs that shows your AI coding spend over the last <b>1 day / 7 days / 30 days</b>, scoped to the IDE host you're working in. One line, one click — no tool window, no popup, no nag.</p>

        <p><code>budi · $1.42 1d · $8.30 7d · $34.21 30d</code></p>

        <h3>Widget states</h3>
        <table>
            <tr>
                <th>State</th>
                <th>Status bar</th>
                <th>Meaning</th>
            </tr>
            <tr>
                <td>Healthy</td>
                <td><code>budi · $X 1d · $Y 7d · $Z 30d</code></td>
                <td>Daemon reachable, traffic in rolling window</td>
            </tr>
            <tr>
                <td>Idle</td>
                <td><code>budi · $0.00 1d · $0.00 7d · $0.00 30d</code></td>
                <td>Daemon reachable, no traffic (not an error)</td>
            </tr>
            <tr>
                <td>Offline</td>
                <td><code>budi · offline</code></td>
                <td>Daemon unreachable or api_version too old</td>
            </tr>
            <tr>
                <td>Loading</td>
                <td><code>budi</code></td>
                <td>Plugin starting, first reading not fetched yet</td>
            </tr>
            <tr>
                <td>Setup</td>
                <td><code>budi · setup</code></td>
                <td>First run, daemon not installed. Balloon offers the install command</td>
            </tr>
        </table>

        <h3>Install</h3>
        <p>Search <b>budi</b> in <b>Settings → Plugins → Marketplace</b>, or run:<br/>
        <code>budi integrations install --with jetbrains-plugin</code></p>

        <h3>Prerequisites</h3>
        <p>The <a href="https://getbudi.dev">budi daemon</a> must be installed and running. Run <code>budi init</code> to get started.</p>

        <p>JetBrains-rooted usage is tracked under the <code>jetbrains</code> surface so the <a href="https://app.getbudi.dev">cloud dashboard</a> can break costs down by editor. Click the widget to jump there.</p>

        <h3>Ecosystem</h3>
        <p>
            <a href="https://getbudi.dev">budi</a> (daemon) ·
            <a href="https://github.com/anthropics/budi-cursor">budi-cursor</a> (Cursor/VS Code extension) ·
            <a href="https://app.getbudi.dev">budi-cloud</a> (dashboard) ·
            <a href="https://getbudi.dev">getbudi.dev</a>
        </p>
    ]]></description>

    <change-notes><![CDATA[
        <h3>0.1.0</h3>
        <ul>
            <li>Initial release. Status-bar widget, daemon health polling, surface=jetbrains analytics filter.</li>
        </ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Application-scoped services. Project-scoped poller would
             multiply daemon hits by the number of open projects. -->
        <applicationService
            serviceImplementation="com.github.siropkin.budijetbrains.settings.BudiSettings"/>
        <applicationService
            serviceImplementation="com.github.siropkin.budijetbrains.state.BudiAppState"/>
        <applicationService
            serviceImplementation="com.github.siropkin.budijetbrains.poller.BudiPoller"/>
        <applicationService
            serviceImplementation="com.github.siropkin.budijetbrains.notifier.BudiUpgradeNotifier"/>

        <!-- Status bar widget. One instance per open project; reads from
             the application-scoped state above. -->
        <statusBarWidgetFactory
            id="BudiStatusBarWidget"
            implementation="com.github.siropkin.budijetbrains.statusbar.BudiStatusBarWidgetFactory"
            order="last"/>

        <!-- Settings page rendered under Settings → Tools → budi. -->
        <applicationConfigurable
            parentId="tools"
            id="com.github.siropkin.budijetbrains.settings.BudiConfigurable"
            displayName="budi"
            instance="com.github.siropkin.budijetbrains.settings.BudiConfigurable"/>

        <!-- Sticky balloon group for the welcome notification + later the
             upgrade-prompt notification (#7). isLogByDefault keeps the
             notification searchable in Event Log if it's dismissed before
             the user reads it. -->
        <notificationGroup
            id="Budi"
            displayType="STICKY_BALLOON"
            isLogByDefault="true"/>

        <!-- Boot the poller + welcome notification on first project open. -->
        <postStartupActivity
            implementation="com.github.siropkin.budijetbrains.startup.BudiProjectActivity"/>
    </extensions>
</idea-plugin>
